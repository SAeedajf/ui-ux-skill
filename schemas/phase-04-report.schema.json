{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SAeedajf/ui-ux-skill/blob/main/schemas/phase-04-report.schema.json",
  "title": "UI/UX Pro Phase 04 acceptance report",
  "type": "object",
  "required": [
    "phase", "status", "base_commit", "output_commit", "plugin_version",
    "skills_count", "test_results", "open_gates", "blocked_gates", "ci_status",
    "artifact_url", "artifact_sha256", "risks", "manual_actions", "next_phase"
  ],
  "properties": {
    "phase": { "const": "04" },
    "status": { "enum": ["PASS", "PARTIAL", "BLOCKED", "FAIL"] },
    "base_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "output_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "plugin_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "skills_count": { "const": 15 },
    "test_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "test_type", "executed_at", "method", "evidence", "reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^R[0-9]{2}$" },
          "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "NEEDS_REVIEW"] },
          "test_type": { "type": "string", "minLength": 1 },
          "executed_at": { "type": ["string", "null"], "format": "date-time" },
          "method": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string" },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "minItems": 18
    },
    "open_gates": { "type": "array", "items": { "type": "string", "pattern": "^R[0-9]{2}$" }, "uniqueItems": true },
    "blocked_gates": { "type": "array", "items": { "type": "string", "pattern": "^R[0-9]{2}$" }, "uniqueItems": true },
    "ci_status": { "enum": ["PENDING", "PASS", "FAIL", "BLOCKED"] },
    "artifact_url": { "type": ["string", "null"], "format": "uri" },
    "artifact_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "risks": { "type": "array", "items": { "type": "string" } },
    "manual_actions": { "type": "array", "items": { "type": "string" } },
    "next_phase": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
