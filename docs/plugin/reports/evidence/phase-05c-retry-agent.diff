diff --git a/style.css b/style.css
index f1baff1..58c4498 100644
--- a/style.css
+++ b/style.css
@@ -1,5 +1,55 @@
-body { margin: 0; font-family: sans-serif; }
-.page { width: 720px; margin: auto; }
-.grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
-.error { color: #9d9d9d; background: #ffffff; }
-.icon-button { border: 0; }
+* { box-sizing: border-box; }
+
+body { margin: 0; font-family: sans-serif; color: #1f2937; background: #f8fafc; }
+
+.site-header,
+.page {
+  width: min(100% - 2rem, 720px);
+  margin-inline: auto;
+}
+
+.site-header {
+  display: flex;
+  align-items: center;
+  gap: 1rem;
+  padding-block: 1rem;
+}
+
+.site-header h1 { margin: 0; font-size: 1.5rem; }
+
+#mobile-menu { margin-inline-start: auto; }
+
+.page { padding-block-end: 2rem; }
+
+.grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
+
+article,
+form {
+  min-width: 0;
+  padding: 1rem;
+  border: 1px solid #cbd5e1;
+  border-radius: .5rem;
+  background: #ffffff;
+}
+
+article h2 { overflow-wrap: anywhere; }
+
+form { display: grid; gap: .75rem; margin-block-start: 1rem; }
+
+input { width: 100%; padding: .6rem .75rem; border: 1px solid #64748b; border-radius: .25rem; }
+
+.field-hint { margin: 0; color: #475569; }
+
+.error { min-height: 1.5em; margin: 0; color: #8b1a1a; background: #ffffff; }
+
+.icon-button { border: 0; padding: .5rem; font-size: 1.25rem; cursor: pointer; }
+
+button:focus-visible,
+a:focus-visible,
+input:focus-visible { outline: 3px solid #0f766e; outline-offset: 2px; }
+
+@media (max-width: 40rem) {
+  .site-header { flex-wrap: wrap; }
+  #mobile-menu { width: 100%; margin-inline-start: 0; }
+  .grid { grid-template-columns: 1fr; }
+}
