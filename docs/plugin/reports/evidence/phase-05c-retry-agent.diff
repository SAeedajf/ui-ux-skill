@@ -1,7 +1,28 @@
 const trigger = document.querySelector('#menu-trigger');
 const menu = document.querySelector('#mobile-menu');
-trigger.addEventListener('click', () => { menu.hidden = !menu.hidden; });
+const phone = document.querySelector('#phone');
+const error = document.querySelector('#error');
+
+function setMenuState(isOpen) {
+  menu.hidden = !isOpen;
+  trigger.setAttribute('aria-expanded', String(isOpen));
+  trigger.setAttribute('aria-label', isOpen ? 'بستن منو' : 'باز کردن منو');
+}
+
+trigger.addEventListener('click', () => {
+  setMenuState(menu.hidden);
+});
+
+document.addEventListener('keydown', event => {
+  if (event.key === 'Escape' && !menu.hidden) {
+    setMenuState(false);
+    trigger.focus();
+  }
+});
+
 document.querySelector('#contact').addEventListener('submit', event => {
   event.preventDefault();
-  document.querySelector('#error').textContent = 'شماره واردشده معتبر نیست';
+  phone.setAttribute('aria-invalid', 'true');
+  error.textContent = 'شماره واردشده معتبر نیست';
+  document.querySelector('#phone').focus();
 });
